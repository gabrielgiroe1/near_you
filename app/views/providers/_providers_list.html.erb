<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
  <% @providers&.each do |provider| %>
    <%= render ProviderCardComponent.new(provider: provider, current_user: current_user) %>
  <% end %>
</div>

<%# No Providers State %>
<% if @providers.blank? %>
  <div class="text-center py-16">
    <div class="max-w-md mx-auto">
      <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <%= inline_svg_tag("search-icon.svg", class: "w-10 h-10 text-gray-400") %>
      </div>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">No providers found</h3>
      <p class="text-gray-600 mb-6">Try adjusting your search filters to find more providers in your area.</p>
      <%= link_to "Clear all filters", providers_path, class: "inline-flex items-center px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors" %>
    </div>
  </div>
<% end %>
