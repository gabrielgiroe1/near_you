<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-6">
  <% @providers&.each do |provider| %>
    <%= link_to provider_path(provider), class: "block group", data: {turbo: false} do %>
      <div class="bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 group-hover:border-blue-200 overflow-hidden">
        <!-- Header with Image and Basic Info -->
        <div class="p-6">
          <div class="flex items-start gap-4">
            <!-- Profile Image -->
            <div class="flex-shrink-0 relative">
              <% if provider.profile_picture.attached? %>
                <%= image_tag provider.profile_picture, class: "w-16 h-16 rounded-full object-cover ring-2 ring-gray-100" %>
              <% else %>
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center ring-2 ring-gray-100">
                  <span class="text-white font-semibold text-lg"><%= provider.user.name&.first&.upcase %></span>
                </div>
              <% end %>
              <!-- Verification Badge -->
              <div class="absolute -bottom-1 -right-1 bg-green-500 text-white rounded-full p-1">
                <%= inline_svg_tag("checkmark.svg", class: "w-3 h-3") %>
              </div>
            </div>

            <!-- Provider Info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                    <%= provider.user.name %>
                  </h3>
                  <p class="text-sm text-gray-600 capitalize font-medium mb-1">
                    <%= provider.service_type.humanize %>
                  </p>
                  <div class="flex items-center text-sm text-gray-500 mb-2">
                    <%= inline_svg_tag("location-marker.svg", class: "w-4 h-4 mr-1") %>
                    <%= provider.location %>
                  </div>
                </div>

                <!-- Price Badge -->
                <div class="text-right">
                  <div class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                    <span class="text-lg font-bold"><%= provider.hourly_rate %></span>
                    <span class="text-sm">RON/hr</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Rating and Reviews -->
          <div class="mt-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <% if provider.rating %>
                <div class="flex items-center">
                  <% full_stars = provider.rating.to_i %>
                  <% half_star = (provider.rating % 1 >= 0.5) %>
                  <% empty_stars = 5 - full_stars - (half_star ? 1 : 0) %>

                  <div class="flex items-center">
                    <!-- Full Stars -->
                    <% full_stars.times do %>
                      <%= inline_svg_tag("solid/star.svg", class: "w-4 h-4 text-yellow-400") %>
                    <% end %>
                    <!-- Half Star -->
                    <% if half_star %>
                      <div class="relative">
                        <%= inline_svg_tag("star.svg", class: "w-4 h-4 text-gray-300") %>
                        <div class="absolute inset-0 overflow-hidden" style="width: 50%">
                          <%= inline_svg_tag("solid/star.svg", class: "w-4 h-4 text-yellow-400") %>
                        </div>
                      </div>
                    <% end %>
                    <!-- Empty Stars -->
                    <% empty_stars.times do %>
                      <%= inline_svg_tag("star.svg", class: "w-4 h-4 text-gray-300") %>
                    <% end %>
                  </div>

                  <span class="ml-2 text-sm font-medium text-gray-700">
                    <%= sprintf("%.1f", provider.rating) %>
                  </span>
                  <span class="text-sm text-gray-500 ml-1">
                    (<%= provider.reviews.count %> review<%= provider.reviews.count == 1 ? '' : 's' %>)
                  </span>
                </div>
              <% else %>
                <div class="flex items-center">
                  <div class="flex">
                    <% 5.times do %>
                      <%= inline_svg_tag("star.svg", class: "w-4 h-4 text-gray-300") %>
                    <% end %>
                  </div>
                  <span class="ml-2 text-sm text-gray-500">New provider</span>
                </div>
              <% end %>
            </div>

            <!--Years of Experience -->
            <div class="text-sm text-gray-600 bg-gray-50 px-3 py-1 rounded-full">
              <%= provider.experience %> years of experience
            </div>
          </div>
          
            <!-- Experience Badge -->
            <div class="text-sm text-gray-600 bg-gray-50 px-3 py-1 rounded-full">
              <%=  provider.appointments.count %> appointments
            </div>

          <!-- Quick Stats -->
          <div class="mt-4 flex items-center gap-4 text-sm text-gray-600">
            <div class="flex items-center">
              <%= inline_svg_tag("calendar.svg", class: "w-4 h-4 mr-1") %>
              <span class="<%= provider.next_available_day == Date.current ? 'text-green-600 font-medium' : 'text-gray-600' %>">
                <%= provider.next_available_day_text %>
              </span>
            </div>
            <div class="flex items-center">
              <%= inline_svg_tag("user.svg", class: "w-4 h-4 mr-1") %>
              Responds quickly
            </div>
          </div>
        </div>

        <!-- Footer CTA -->
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
          <div class="flex items-center justify-between">
            <% unless provider.can_accept_bookings? %>
              <span class="text-sm text-yellow-600 font-medium">Setup in progress</span>
              <%= inline_svg_tag("warning.svg", class: "w-5 h-5 text-yellow-500") %>
            <% else %>
              <span class="text-sm text-gray-600">View profile & book</span>
              <%= inline_svg_tag("arrow-right.svg", class: "w-5 h-5 text-blue-500 group-hover:translate-x-1 transition-transform") %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<!-- No Providers State -->
<% if @providers.blank? %>
  <div class="text-center py-16">
    <div class="max-w-md mx-auto">
      <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <%= inline_svg_tag("search-icon.svg", class: "w-10 h-10 text-gray-400") %>
      </div>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">No providers found</h3>
      <p class="text-gray-600 mb-6">Try adjusting your search filters to find more providers in your area.</p>
      <%= link_to "Clear all filters", providers_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" %>
    </div>
  </div>
<% end %>