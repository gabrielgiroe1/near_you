<% has_filters = params[:service_type].present? || params[:category].present? || params[:search].present? || params[:location].present? %>

<% if has_filters %>
  <!-- Filtered Providers Page -->
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar Filters -->
      <div class="lg:w-80 flex-shrink-0">
        <div class="sticky top-6">
          <%= render partial: "filter_providers", locals: { providers: @providers } %>
        </div>
      </div>

      <!-- Providers List -->
      <div id="providers-container" class="flex-1">
        <!-- Results Header -->
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-semibold text-gray-900">
              <% if params[:service_type].present? %>
                <%= params[:service_type].humanize %> Providers
              <% elsif params[:category].present? %>
                <%= params[:category] %> Providers
              <% elsif params[:search].present? %>
                Results for "<%= params[:search] %>"
              <% elsif params[:location].present? %>
                Providers in <%= params[:location] %>
              <% else %>
                All Providers
              <% end %>
            </h2>
            <p class="text-gray-600">
              <span class="font-medium"><%= @pagy.count %></span>
              provider<%= @pagy.count == 1 ? '' : 's' %> available
              <% if params[:location].present? %>
                in <span class="font-medium"><%= params[:location] %></span>
              <% end %>
            </p>
          </div>

          <!-- Sort Options -->
          <div class="hidden sm:block">
            <%= form_with url: providers_path, method: :get, local: true, class: "flex items-center gap-2" do |form| %>
              <% %w[category service_type location search min_price max_price].each do |param| %>
                <%= form.hidden_field param.to_sym, value: params[param] if params[param].present? %>
              <% end %>
              <%= form.select :sort,
                options_for_select([
                  ['Most Popular', 'popular'],
                  ['Highest Rated', 'rating'],
                  ['Lowest Price', 'price_low'],
                  ['Highest Price', 'price_high'],
                  ['Most Recent', 'recent']
                ], selected: params[:sort]),
                { prompt: 'Sort by' },
                {
                  class: "text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                  onchange: "this.form.submit();"
                }
              %>
            <% end %>
          </div>
        </div>

        <%= turbo_frame_tag "providers" do %>
          <%= render partial: "providers_list", locals: { providers: @providers } %>

          <!-- Pagination -->
          <% if @pagy.present? %>
            <div class="mt-12 flex justify-center">
              <%== pagy_nav(@pagy) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <!-- Homepage: Discovery View -->
  <div class="max-w-7xl mx-auto py-8 md:py-16">
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
        Programează-te online
      </h1>

      <%= render SearchBarComponent.new(search: params[:search], location: params[:location]) %>
    </div>
  </div>

  <%= render CategoryCardsComponent.new %>
<% end %>
