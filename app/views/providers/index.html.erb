<% if user_signed_in? %>
  <% if current_user.user? %>
    <h2 class="text-4xl font-semibold mb-6">Browse Providers</h2>
    <div class="flex flex-wrap gap-6 mb-8">
      <!-- Filter Providers -->
      <div class="w-full lg:w-1/4 xl:w-1/5">
        <%= render partial: "filter_providers", locals: { providers: @providers } %>
      </div>

      <!-- Providers List -->
      <div id="providers-container" class="w-full lg:w-3/4 xl:w-4/5">
        <%= turbo_frame_tag "providers" do %>
          <%= render partial: "providers_list", locals: { providers: @providers } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <%= render HomepageComponent.new %>
<% end %>