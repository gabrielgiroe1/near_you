<%= turbo_stream.replace "favorite_button_#{@provider.id}" do %>
  <%= render "favorites/favorite_button", provider: @provider %>
<% end %>

<%= turbo_stream.remove "favorite_#{@favorite.id}" %>
<%= turbo_stream.replace "favorites_stats" do %>
  <div id="favorites_stats" class="flex gap-8 mb-12 text-sm text-gray-600">
    <div><span class="font-medium text-gray-900"><%= current_user.favorites.count %></span> favorites&nbsp;</div>
    <div><span class="font-medium text-gray-900"><%= current_user.appointments.joins(:provider).where(providers: { id: current_user.favorites.pluck(:provider_id) }).count %></span> total appointments</div>
  </div>
<% end %>