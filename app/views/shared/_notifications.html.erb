<div class="relative" data-controller="notifications">
  <button id="dropdownNotificationButton" 
          data-action="click->notifications#toggle"
          class="relative inline-flex items-center text-sm font-medium text-center text-gray-500 hover:text-gray-900 focus:outline-none" 
          type="button">
    <%= inline_svg_tag("notification.svg", class: "w-5 h-5") %>
    <% if current_user.notifications.unread.any? %>
      <div class="absolute block w-3 h-3 bg-red-500 border-2 border-white rounded-full -top-0.5 start-2.5"></div>
    <% end %>
  </button>

  <div data-notifications-target="menu" 
       class="hidden absolute right-0 mt-2 w-80 bg-white divide-y divide-gray-100 rounded-lg shadow-lg">
    <div class="block px-4 py-2 font-medium text-center text-gray-700 rounded-t-lg bg-gray-50">
      Notifications
    </div>
    <div class="divide-y divide-gray-100 max-h-96 overflow-y-auto">
      <% current_user.notifications.newest_first.each do |notification| %>
        <%= form_tag read_notification_path(notification), method: :patch, class: "w-full" do %>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <button type="submit" class="flex px-4 py-3 hover:bg-gray-100 w-full <%= notification.read_at ? 'bg-white' : 'bg-blue-50' %>">
            <div class="w-full">
              <div class="text-gray-500 text-sm mb-1.5">
                <%if current_user.provider?%>
                  <%= notification.event.message_provider %>
                <%else%>
                  <%= notification.event.message_user %>
                <%end%>
              </div>
              <div class="text-xs text-blue-600">
                <%= time_ago_in_words(notification.created_at) %> ago
              </div>
            </div>
          </button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>