<!-- Search Modal -->
<div id="search-modal"
     class="hidden fixed inset-0 z-50"
     data-controller="search-modal"
     data-context="service"
     role="dialog"
     aria-modal="true"
     aria-labelledby="search-modal-title">

  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/50 transition-opacity duration-300 opacity-0"
       data-role="backdrop"
       data-action="click->search-modal#close"></div>

  <!-- Modal Panel -->
  <div class="absolute inset-x-0 bottom-0 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2
              bg-white rounded-t-2xl md:rounded-2xl shadow-xl
              max-h-[85vh] md:max-h-[600px] md:w-full md:max-w-lg
              flex flex-col
              transform transition-all duration-300
              translate-y-full md:translate-y-[-50%] scale-95 opacity-0"
       data-role="panel">

    <!-- Header -->
    <div class="flex items-center gap-4 p-4 border-b border-gray-200">
      <button type="button"
              class="p-2 -ml-2 hover:bg-gray-100 rounded-full transition-colors"
              data-action="click->search-modal#close"
              aria-label="Închide">
        <%= inline_svg_tag("chevron-left.svg", class: "w-5 h-5 text-gray-600") %>
      </button>
      <h2 id="search-modal-title" class="text-lg font-semibold text-gray-900">Caută</h2>
    </div>

    <!-- Both Search Inputs -->
    <div class="p-4 space-y-3 border-b border-gray-100">
      <!-- Service Search Input -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <%= inline_svg_tag("search.svg", class: "w-5 h-5 text-gray-400") %>
        </div>
        <input type="text"
               class="w-full border border-gray-300 bg-gray-50 rounded-xl py-3 pl-10 pr-4 text-sm placeholder-gray-500 focus:outline-none transition-all"
               placeholder="Caută servicii sau furnizori..."
               data-role="serviceInput"
               data-action="input->search-modal#onServiceInput keydown->search-modal#handleKeydown focus->search-modal#switchToService"
               autocomplete="off">
      </div>

      <!-- Location Search Input -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <%= inline_svg_tag("location.svg", class: "w-5 h-5 text-gray-400") %>
        </div>
        <input type="text"
               class="w-full border border-gray-300 bg-gray-50 rounded-xl py-3 pl-10 pr-4 text-sm placeholder-gray-500 focus:outline-none transition-all"
               placeholder="Alege orașul..."
               data-role="locationInput"
               data-action="input->search-modal#onLocationInput keydown->search-modal#handleKeydown focus->search-modal#switchToLocation"
               autocomplete="off">
      </div>
    </div>

    <!-- Results Area -->
    <div class="flex-1 overflow-y-auto">
      <!-- Service Context Content -->
      <div data-role="serviceContext">
        <!-- Live Search Results (hidden initially) -->
        <div class="hidden p-4" data-role="results">
          <div id="search-results-list" class="space-y-1">
            <!-- Results populated by Turbo Stream -->
          </div>
        </div>

        <!-- Default Content (popular services & categories) -->
        <div data-role="defaultContent">
          <!-- Popular Services -->
          <div class="p-4">
            <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Servicii populare</h3>
            <div class="flex flex-wrap gap-2">
              <% popular_services.each do |service| %>
                <button type="button"
                        class="px-3 py-2 bg-gray-100 hover:bg-blue-100 hover:text-blue-700 text-sm text-gray-700 rounded-lg transition-colors"
                        data-action="click->search-modal#selectService"
                        data-service="<%= service %>">
                  <%= service %>
                </button>
              <% end %>
            </div>
          </div>

          <!-- Categories -->
          <div class="p-4 pt-0">
            <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Categorii</h3>
            <div class="space-y-2">
              <% categories.each do |category, services| %>
                <details class="group">
                  <summary class="flex items-center justify-between p-3 bg-gray-50 hover:bg-gray-100 rounded-lg cursor-pointer transition-colors list-none">
                    <span class="font-medium text-gray-900"><%= category %></span>
                    <%= inline_svg_tag("chevron-right.svg", class: "w-4 h-4 text-gray-400 transition-transform group-open:rotate-90") %>
                  </summary>
                  <div class="mt-1 ml-4 space-y-1">
                    <% services.each do |service| %>
                      <button type="button"
                              class="w-full text-left px-3 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-700 rounded-lg transition-colors"
                              data-action="click->search-modal#selectService"
                              data-service="<%= service %>">
                        <%= service %>
                      </button>
                    <% end %>
                  </div>
                </details>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Location Context Content -->
      <div class="hidden" data-role="locationContext">
        <!-- Geolocation Button -->
        <div class="p-4 pb-2">
          <button type="button"
                  class="w-full flex items-center gap-3 p-3 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-xl transition-colors"
                  data-action="click->search-modal#useMyLocation">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="font-medium" data-role="geoText">Locația ta</span>
          </button>
        </div>

        <!-- Cities List -->
        <div class="p-4 pt-2">
          <div class="space-y-1">
            <% cities.each do |city| %>
              <button type="button"
                      class="w-full flex items-center gap-3 p-3 text-left hover:bg-gray-100 rounded-lg transition-colors"
                      data-action="click->search-modal#selectLocation"
                      data-city="<%= city %>"
                      data-role="cityItem">
                <%= inline_svg_tag("search.svg", class: "w-4 h-4 text-gray-400 flex-shrink-0") %>
                <span class="text-gray-900"><%= city %></span>
                <% if city == current_location %>
                  <%= inline_svg_tag("check.svg", class: "w-4 h-4 text-blue-600 ml-auto") %>
                <% end %>
              </button>
            <% end %>
          </div>

          <!-- No results message -->
          <p class="hidden text-center text-gray-500 py-8" data-role="noLocationResults">
            Nu s-au găsit rezultate
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
