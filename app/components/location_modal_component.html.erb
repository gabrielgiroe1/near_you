<!-- Location Modal -->
<div id="location-modal"
     class="hidden fixed inset-0 z-50"
     data-controller="location-modal"
     data-action="open-location-modal@window->location-modal#open"
     role="dialog"
     aria-modal="true"
     aria-labelledby="location-modal-title">

  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/50 transition-opacity duration-300 opacity-0"
       data-location-modal-target="backdrop"
       data-action="click->location-modal#close"></div>

  <!-- Modal Panel -->
  <div class="absolute inset-x-0 bottom-0 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2
              bg-white rounded-t-2xl md:rounded-2xl shadow-xl
              max-h-[85vh] md:max-h-[80vh] md:w-full md:max-w-lg
              flex flex-col
              transform transition-all duration-300
              translate-y-full md:translate-y-0 md:scale-95 md:opacity-0"
       data-location-modal-target="panel">

    <!-- Header -->
    <div class="flex items-center gap-4 p-4 border-b border-gray-200">
      <button type="button"
              class="p-2 -ml-2 hover:bg-gray-100 rounded-full transition-colors"
              data-action="click->location-modal#close"
              aria-label="Închide">
        <%= inline_svg_tag("chevron-left.svg", class: "w-5 h-5 text-gray-600") %>
      </button>
      <h2 id="location-modal-title" class="text-lg font-semibold text-gray-900">Selectează locația</h2>
    </div>

    <!-- Geolocation Button -->
    <div class="p-4 border-b border-gray-100">
      <button type="button"
              class="w-full flex items-center gap-3 p-3 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-xl transition-colors"
              data-action="click->location-modal#useMyLocation"
              data-location-modal-target="geoButton">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="font-medium" data-location-modal-target="geoText">Folosește locația mea</span>
      </button>
      <!-- Geolocation error message -->
      <p class="hidden mt-2 text-sm text-red-600" data-location-modal-target="geoError"></p>
    </div>

    <!-- Search Input -->
    <div class="p-4 pb-2">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <%= inline_svg_tag("search.svg", class: "w-5 h-5 text-gray-400") %>
        </div>
        <input type="text"
               class="w-full border border-gray-300 bg-gray-50 rounded-xl py-3 pl-10 pr-4 text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
               placeholder="Caută oraș..."
               data-location-modal-target="input"
               data-action="input->location-modal#filterCities keydown->location-modal#onKeydown"
               autocomplete="off">
      </div>
    </div>

    <!-- Cities List -->
    <div class="flex-1 overflow-y-auto p-4 pt-2">
      <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Orașe disponibile</h3>
      <div class="space-y-1" data-location-modal-target="citiesList">
        <% cities.each do |city| %>
          <button type="button"
                  class="w-full flex items-center gap-3 p-3 text-left hover:bg-gray-100 rounded-lg transition-colors city-item"
                  data-action="click->location-modal#selectCity"
                  data-city="<%= city %>"
                  data-location-modal-target="cityItem">
            <%= inline_svg_tag("location.svg", class: "w-4 h-4 text-gray-400 flex-shrink-0") %>
            <span class="text-gray-900"><%= city %></span>
            <% if city == current_location %>
              <%= inline_svg_tag("check.svg", class: "w-4 h-4 text-blue-600 ml-auto") %>
            <% end %>
          </button>
        <% end %>
      </div>

      <!-- No results message -->
      <p class="hidden text-center text-gray-500 py-8" data-location-modal-target="noResults">
        Nu s-au găsit rezultate
      </p>
    </div>
  </div>
</div>
