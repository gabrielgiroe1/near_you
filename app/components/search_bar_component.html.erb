<div class="w-full max-w-3xl mx-auto"
     data-controller="hero-search"
     data-action="service-selected->hero-search#selectService location-selected->hero-search#selectLocation">
  <%= form_with url: providers_path, method: :get, local: true, data: { hero_search_target: "form" } do |form| %>
    <!-- Hidden inputs for search and location -->
    <%= form.hidden_field :search, value: search, data: { hero_search_target: "searchInput" } %>
    <%= form.hidden_field :location, value: location, data: { hero_search_target: "locationInput" } %>

    <!-- Search Bar Container -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-2 flex flex-col md:flex-row items-stretch">
      <!-- Service Search Section -->
      <button type="button"
              class="flex-1 flex items-center gap-3 px-4 py-3 text-left hover:bg-gray-50 rounded-xl transition-colors"
              data-action="click->hero-search#openServiceModal">
        <%= inline_svg_tag("search.svg", class: "w-5 h-5 text-gray-400 flex-shrink-0") %>
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-medium text-gray-500">Ce cauți?</span>
          <span class="text-sm text-gray-900 truncate" data-hero-search-target="serviceDisplay">
            <%= search.present? ? search : "Caută servicii" %>
          </span>
        </div>
      </button>

      <!-- Divider -->
      <div class="hidden md:block w-px bg-gray-200 my-2"></div>
      <div class="md:hidden h-px bg-gray-200 mx-4"></div>

      <!-- Location Section -->
      <button type="button"
              class="flex-1 flex items-center gap-3 px-4 py-3 text-left hover:bg-gray-50 rounded-xl transition-colors"
              data-action="click->hero-search#openLocationModal">
        <%= inline_svg_tag("location.svg", class: "w-5 h-5 text-gray-400 flex-shrink-0") %>
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-medium text-gray-500">Unde?</span>
          <span class="text-sm text-gray-900 truncate" data-hero-search-target="locationDisplay">
            <%= location.present? ? location : "Selectează locația" %>
          </span>
        </div>
      </button>

      <!-- Search Button -->
      <button type="submit"
              class="mt-2 md:mt-0 md:ml-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl transition-colors flex items-center justify-center gap-2">
        <%= inline_svg_tag("search.svg", class: "w-5 h-5") %>
        <span>Caută</span>
      </button>
    </div>
  <% end %>

  <!-- Service Search Modal -->
  <%= render SearchModalComponent.new(
    service_types: service_types,
    categories: categories,
    popular_services: popular_services,
    current_search: search
  ) %>

  <!-- Location Modal -->
  <%= render LocationModalComponent.new(
    cities: cities,
    current_location: location
  ) %>
</div>
