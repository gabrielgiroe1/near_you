<footer class="<%= container_classes %> bg-gray-100 w-full mt-auto my-6 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-6">
      <!-- Logo -->
      <div class="mb-4">
        <%= link_to root_path, class: "transition-opacity hover:opacity-80" do %>
          <h2 class="text-2xl font-bold text-gray-900">Near You</h2>
        <% end %>
      </div>

      <!-- Multi-Column Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-6">
        <!-- Services Column -->
        <div>
          <h3 class="text-base font-semibold mb-3 text-gray-900">Services</h3>
          <ul class="flex flex-col gap-1">
            <li><%= link_to "Home Services", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Beauty & Wellness", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Health Services", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Education", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
          </ul>
        </div>

        <!-- Company Column -->
        <div>
          <h3 class="text-base font-semibold mb-3 text-gray-900">Company</h3>
          <ul class="flex flex-col gap-1">
            <li><%= link_to "About Us", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "How it Works", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Careers", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Help Center", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
          </ul>
        </div>

        <!-- Support Column -->
        <div>
          <h3 class="text-base font-semibold mb-3 text-gray-900">Support</h3>
          <ul class="flex flex-col gap-1">
            <li><%= link_to "Contact Us", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "FAQ", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Terms", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
            <li><%= link_to "Privacy", "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200" %></li>
          </ul>
        </div>

        <!-- Connect Column -->
        <div>
          <h3 class="text-base font-semibold mb-3 text-gray-900">Connect</h3>
          <ul class="flex flex-col gap-1">
            <li>
              <%= link_to "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200 flex items-center gap-1" do %>
                <%= inline_svg_tag("instagram-icon.svg", class: "w-3 h-3") %>
                Instagram
              <% end %>
            </li>
            <li>
              <%= link_to "#", class: "text-sm text-gray-600 hover:text-gray-900 transition-colors duration-200 flex items-center gap-1" do %>
                <%= inline_svg_tag("facebook-icon.svg", class: "w-3 h-3") %>
                Facebook
              <% end %>
            </li>
          </ul>
        </div>
      </div>

      <!-- Divider -->
      <div class="h-px w-full bg-gray-300 my-4"></div>

      <!-- Copyright -->
      <div class="text-center pb-4">
        <p class="text-sm text-gray-500">
          © <%= Date.current.year %> Near You. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>