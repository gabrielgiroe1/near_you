<nav class="bg-white shadow-lg mb-8">
      <div class="max-w-6xl mx-auto px-4 py-3">
        <div class="flex justify-between items-center">
          <%= link_to "Near You", root_path, class:"text-2xl font-bold text-blue-500"%>
          <div class="flex-grow max-w-md">
            <%= form_with url: providers_path, method: :get, local: true do |form| %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                  <%= inline_svg_tag("search.svg", class: "w-5 h-5 text-gray-400") %>
                </div>
                <%= form.search_field :search,
                  value: params[:search],
                  placeholder: "Search services or providers",
                  class: "w-full border border-gray-300 bg-gray-50 rounded-md py-2 pl-11 pr-4 text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-400" %>

              </div>
            <% end %>
          </div>
          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <!-- Main Navigation Menu -->
              <div class="relative" data-controller="dropdown">
                <button class="flex items-center gap-1 text-gray-700 hover:text-gray-900" data-action="click->dropdown#toggle">
                  <span><%= current_user.name || current_user.email %></span>
                  <%= inline_svg_tag("chevron-down.svg", class: "w-4 h-4") %>
                </button>
                <!-- Dropdown Menu -->
                <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 hidden" data-dropdown-target="menu">
                  <%= link_to "Edit Profile", current_user.user? ? edit_user_registration_path : edit_provider_path(current_user.provider), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <%= link_to "My Appointments", appointments_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <% if current_user.provider? %>
                    <%= link_to "My Provider Profile", provider_path(current_user.provider),
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <% else %>
                    <%= link_to "Browse Providers", root_path,
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                    <%= button_to "Become a Provider", new_provider_path,
                      method: :get,
                      class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>

                    <%= link_to "My Favorites", favorites_path, method: :get,
                      class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <% end %>
                  <div class="border-t border-gray-100"></div>
                  <%= button_to "Logout", destroy_user_session_path,
                    method: :delete,
                    class: "block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100" %>
                </div>
              </div>
              <%= render "shared/notifications" if user_signed_in? %>
            <% else %>
              <!-- Guest Navigation Links -->
              <div data-controller="dropdown">
                <button data-action="click->dropdown#toggle" class="flex items-center gap-1">
                  <%= inline_svg_tag("default_profile_picture.svg", class: "w-6 h-4 cursor-pointer rounded-full", override: true) %>
                </button>
                <div data-dropdown-target="menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 hidden z-10">
                  <%= link_to "Sign In", new_user_session_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <%= link_to "Sign Up", new_user_registration_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                </div>
              </div>

            <% end %>
          </div>
        </div>
      </div>
    </nav>