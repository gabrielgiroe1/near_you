<section class="max-w-7xl mx-auto py-8 md:py-12">
  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 text-center mb-8">
    Servicii populare
  </h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
    <% CATEGORIES.each do |category| %>
      <%= link_to providers_path(category[:filters]), class: "group block" do %>
        <div class="aspect-square rounded-2xl overflow-hidden mb-3">
          <%= image_tag category[:image],
                        alt: category[:name],
                        class: "w-full h-full object-cover transition-transform duration-300 group-hover:scale-105",
                        loading: "lazy" %>
        </div>
        <p class="text-sm md:text-base font-semibold text-gray-900 text-center leading-snug">
          <%= category[:name] %>
        </p>
      <% end %>
    <% end %>
  </div>
</section>
